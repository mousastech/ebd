# ── obrigatório
# Segredo para assinar os cookies de sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=troque-este-valor

# ── banco e arquivos (padrões mostrados)
EBD_DB_PATH=data/ebd.db
EBD_UPLOAD_DIR=data/uploads
EBD_BACKUP_DIR=data/backups
# quantas cópias de segurança diárias manter
EBD_BACKUP_KEEP=30

# Endereço público do sistema (usado no login com Google e nos links do calendário). Ex.: https://ebd.suaigreja.com.br
EBD_PUBLIC_URL=

# ── login com Google (opcional). Crie em https://console.cloud.google.com → APIs e serviços → Credenciais →
#    "ID do cliente OAuth" (aplicativo da Web) com o URI de redirecionamento: <EBD_PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── notificações push (opcional: se vazio, as chaves são geradas e guardadas no banco na primeira vez)
#    para gerar: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:secretaria@suaigreja.com.br

# ── desligar rotinas (0 = desligado): rotinas diárias, cópia automática, envio de push
# EBD_JOBS=0
# EBD_AUTO_BACKUP=0
# EBD_PUSH=0
